<div class="login-fondo" aria-hidden="true">
  <canvas class="login-canvas" id="loginCanvas"></canvas>
  <span class="login-orb login-orb--uno"></span>
  <span class="login-orb login-orb--dos"></span>
  <span class="login-orb login-orb--tres"></span>
  <span class="login-luz" data-login-luz></span>
  <span class="login-particula login-particula--uno" data-login-particula></span>
  <span class="login-particula login-particula--dos" data-login-particula></span>
  <span class="login-particula login-particula--tres" data-login-particula></span>
  <span class="login-particula login-particula--cuatro" data-login-particula></span>
  <span class="login-particula login-particula--cinco" data-login-particula></span>
  <span class="login-rejilla"></span>
</div>

<section class="auth auth--login">
  <div class="auth__marca" data-login="hero">
    <a class="marca marca--auth" href="/login" aria-label="CRACKENTICK">
      <span class="marca__icono marca__icono--logo" aria-hidden="true">
        <svg viewBox="0 0 40 40" fill="none">
          <path d="M20 3.5 34 11v18L20 36.5 6 29V11L20 3.5Z" stroke="currentColor" stroke-width="1.8"/>
          <path d="M13 24c1.8-3.2 4-4.8 7-4.8s5.2 1.6 7 4.8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
          <path d="M15.5 18.5c1.2-1.5 2.7-2.3 4.5-2.3s3.3.8 4.5 2.3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
          <circle cx="20" cy="27" r="1.8" fill="currentColor"/>
        </svg>
      </span>
      <span class="marca__texto">CRACKEN<span>TICK</span></span>
    </a>

    <div class="login-hero">
      <span class="login-hero__pill"><span class="punto punto--verde"></span> Panel de gestión</span>
      <h1>Todo tu ISP,<br><em>en un solo lugar.</em></h1>
      <p>Clientes, red, facturación y soporte. Entra con tus credenciales para continuar donde lo dejaste.</p>

      <ul class="login-hero__lista">
        <li data-login="feature">
          <span class="login-hero__icono"><%- include('../partials/icon', { nombre: 'users' }) %></span>
          <span><strong>Clientes y servicios</strong><small>Altas, planes, cortes y portal del cliente.</small></span>
        </li>
        <li data-login="feature">
          <span class="login-hero__icono"><%- include('../partials/icon', { nombre: 'server' }) %></span>
          <span><strong>Red y routers</strong><small>IPAM, VLAN, firewall y monitoreo en vivo.</small></span>
        </li>
        <li data-login="feature">
          <span class="login-hero__icono"><%- include('../partials/icon', { nombre: 'receipt' }) %></span>
          <span><strong>Facturación y cobros</strong><small>Facturas, pagos, gastos y rendimiento.</small></span>
        </li>
      </ul>

      <div class="login-hero__senal" aria-hidden="true">
        <span class="auth__senal-linea"></span>
        <span class="auth__senal-punto"></span>
        <span class="auth__senal-linea"></span>
      </div>
    </div>
  </div>

  <div class="auth__panel" data-login="panel">
    <div class="tarjeta auth__tarjeta login-card">
      <span class="login-card__brillo" aria-hidden="true"></span>

      <div class="auth__cabecera login-card__cabecera">
        <span class="login-card__icono" aria-hidden="true"><%- include('../partials/icon', { nombre: 'shield' }) %></span>
        <span class="insignia insignia--morado">Acceso privado</span>
        <h2>Bienvenido de nuevo</h2>
        <p>Ingresa tus credenciales para entrar al panel.</p>
      </div>

      <% if (error) { %>
        <div class="aviso aviso--error auth__error" role="alert" data-login="alerta">
          <span class="aviso__icono"><%- include('../partials/icon', { nombre: 'alert' }) %></span>
          <p class="aviso__texto"><%= error %></p>
        </div>
      <% } %>
      <% if (typeof exito !== 'undefined' && exito && exito.length) { %>
        <div class="aviso aviso--exito auth__error" role="status" data-login="alerta">
          <span class="aviso__icono"><%- include('../partials/icon', { nombre: 'check' }) %></span>
          <p class="aviso__texto"><%= exito[0] %></p>
        </div>
      <% } %>

      <form action="/login" method="post" class="auth__formulario" id="loginForm" data-login="form">
        <div class="campo campo--auth" data-login="field">
          <label for="usuario">Usuario</label>
          <div class="campo__control">
            <%- include('../partials/icon', { nombre: 'user' }) %>
            <input id="usuario" name="usuario" type="text" autocomplete="username" placeholder="Tu usuario" value="<%= usuario || '' %>" autofocus required>
          </div>
        </div>

        <div class="campo campo--auth" data-login="field">
          <label for="password">Contraseña</label>
          <div class="campo__control">
            <%- include('../partials/icon', { nombre: 'shield' }) %>
            <input id="password" name="password" type="password" autocomplete="current-password" placeholder="Tu contraseña" required>
            <button type="button" class="campo__ojo" id="btnOjo" aria-label="Mostrar contraseña" title="Mostrar contraseña">
              <%- include('../partials/icon', { nombre: 'eye' }) %>
            </button>
          </div>
        </div>

        <div class="auth__opciones" data-login="field">
          <label class="check">
            <input type="checkbox" name="recordarme">
            <span>Recordarme por 7 días</span>
          </label>
          <span class="login-card__seguro"><%- include('../partials/icon', { nombre: 'shield' }) %> Sesión protegida</span>
        </div>

        <button type="submit" class="boton boton--primario boton--bloque auth__entrar" data-login="submit">
          Entrar al panel
          <%- include('../partials/icon', { nombre: 'arrowRight' }) %>
        </button>
      </form>

      <div class="auth__pie login-card__pie">
        <span class="punto punto--verde"></span>
        <span>Acceso restringido: solicita credenciales al administrador.</span>
      </div>

      <a class="login-card__portal" href="/portal/login">
        <span><strong>¿Eres cliente?</strong><small>Entra al portal de facturas y tickets</small></span>
        <%- include('../partials/icon', { nombre: 'arrowRight' }) %>
      </a>
    </div>

    <p class="auth__legal">© <%= new Date().getFullYear() %> CRACKENTICK · ISP Management</p>
  </div>
</section>
