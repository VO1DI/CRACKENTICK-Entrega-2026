<section class="error-pagina">
  <div class="tarjeta superficie error-pagina__tarjeta">
    <p class="error-pagina__codigo"><%= typeof status !== 'undefined' ? status : 400 %></p>
    <h2><%= titulo || 'Solicitud inválida' %></h2>
    <p class="texto-suave"><%= mensaje || 'Los datos enviados no cumplen las validaciones.' %></p>
    <% if (typeof detalles !== 'undefined' && detalles && detalles.length) { %>
      <ul class="lista-errores">
        <% detalles.forEach((detalle) => { %><li><%= detalle %></li><% }); %>
      </ul>
    <% } %>
    <div class="error-pagina__acciones">
      <a class="boton boton--primario" href="/">Ir al dashboard</a>
      <a class="boton boton--secundario" href="javascript:history.back()">Volver atrás</a>
    </div>
  </div>
</section>
