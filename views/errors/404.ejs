<section class="error-pagina">
  <div class="tarjeta superficie error-pagina__tarjeta">
    <p class="error-pagina__codigo">404</p>
    <h2><%= titulo || 'Página no encontrada' %></h2>
    <p class="texto-suave"><%= mensaje || 'La ruta que buscas no existe o cambió de lugar.' %></p>
