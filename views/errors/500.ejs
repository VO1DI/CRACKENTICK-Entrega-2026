<section class="error-pagina">
  <div class="tarjeta superficie error-pagina__tarjeta">
    <p class="error-pagina__codigo">500</p>
    <h2><%= titulo || 'Error del servidor' %></h2>
    <p class="texto-suave"><%= mensaje || 'Ocurrió un problema inesperado. Intenta de nuevo en unos segundos.' %></p>
    <% if (typeof stack !== 'undefined' && stack) { %>
      <details class="error-pagina__detalle">
        <summary>Detalle técnico (solo desarrollo)</summary>
        <pre class="bloque-codigo"><code><%= stack %></code></pre>
      </details>
    <% } %>
    <div class="error-pagina__acciones">
      <a class="boton boton--primario" href="/">Ir al dashboard</a>
      <a class="boton boton--secundario" href="/logs">Ver auditoría</a>
    </div>
  </div>
</section>
