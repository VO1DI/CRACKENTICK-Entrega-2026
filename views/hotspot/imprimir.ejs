<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <title>Vouchers · <%= lote.profile %></title>
  <style>
    * { box-sizing: border-box; }
    body { font-family: system-ui, 'Segoe UI', sans-serif; color: #111; margin: 24px; }
    h1 { font-size: 18px; margin: 0 0 4px; }
    p { margin: 0 0 16px; color: #555; font-size: 13px; }
    .rejilla { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
    .voucher { border: 1px dashed #999; border-radius: 8px; padding: 10px 12px; page-break-inside: avoid; }
    .voucher strong { display: block; font-size: 18px; letter-spacing: 0.08em; font-family: ui-monospace, monospace; }
    .voucher span { display: block; font-size: 12px; color: #444; margin-top: 2px; }
    .clave { font-family: ui-monospace, monospace; font-size: 14px; }
    @media print { body { margin: 10mm; } .no-print { display: none; } }
  </style>
</head>
<body>
  <h1>Vouchers · <%= lote.profile %></h1>
  <p><%= lote.routerName %> · <%= lote.quantity %> voucher(s) · <%= lote.durationMinutes || lote.durationHours * 60 ? minutosTexto(lote.durationMinutes || lote.durationHours * 60) : 'sin límite de tiempo' %> · <%= lote.dataLimitMB ? `${lote.dataLimitMB} MB` : 'sin límite de datos' %> · <%= lote.price %> USD</p>
  <p class="no-print"><button onclick="window.print()">Imprimir</button></p>
  <div class="rejilla">
    <% vouchers.forEach((voucher) => { %>
      <div class="voucher">
        <strong><%= voucher.code %></strong>
        <span>Clave: <b class="clave"><%= voucher.password %></b></span>
        <span><%= voucher.durationMinutes || voucher.durationHours * 60 ? minutosTexto(voucher.durationMinutes || voucher.durationHours * 60) : 'Tiempo libre' %><%= voucher.dataLimitMB ? ` · ${voucher.dataLimitMB} MB` : '' %></span>
      </div>
    <% }); %>
  </div>
</body>
</html>
