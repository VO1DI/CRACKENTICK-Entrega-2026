<section class="pagina-cabecera">
  <div>
    <p class="etiqueta">Red · EOIP</p>
    <h2 class="pagina-cabecera__titulo"><%= modo === 'crear' ? 'Nuevo túnel EOIP' : 'Editar túnel EOIP' %></h2>
    <p class="pagina-cabecera__texto"><%= router.name %> · MikroTik RouterOS</p>
  </div>
  <div class="pagina-cabecera__acciones">
    <a class="boton boton--secundario" href="/red/eoip?routerId=<%= router._id %>"><%- include('../partials/icon', { nombre: 'arrowLeft' }) %> Volver</a>
  </div>
</section>

<% if (errores && errores.length) { %>
  <div class="aviso aviso--error" role="alert">
    <span class="aviso__icono"><%- include('../partials/icon', { nombre: 'alert' }) %></span>
    <div class="aviso__texto"><strong>Revisa los datos:</strong><ul class="lista-errores"><% errores.forEach((m) => { %><li><%= m %></li><% }); %></ul></div>
  </div>
<% } %>

<form class="formulario" action="<%= modo === 'crear' ? '/red/eoip' : `/red/eoip/${tunel._id}` %>" method="post">
  <% if (modo === 'editar') { %><input type="hidden" name="_method" value="PUT"><% } %>
  <input type="hidden" name="routerId" value="<%= router._id %>">
  <section class="tarjeta superficie formulario__seccion">
    <div class="formulario__cabecera"><span class="formulario__numero">01</span><div><h3>Túnel EOIP</h3><p>El nombre y el Tunnel ID deben ser únicos en el router.</p></div></div>
    <div class="formulario__rejilla">
      <div class="campo"><label>Router</label><input type="text" value="<%= router.name %>" readonly></div>
      <div class="campo">
        <label for="name">Nombre *</label>
        <input id="name" name="name" type="text" maxlength="40" value="<%= tunel.name || '' %>" placeholder="eoip-nodo-sur" <%= modo === 'editar' ? 'readonly' : 'required' %>>
      </div>
      <div class="campo">
        <label for="remoteAddress">IP remota *</label>
        <input id="remoteAddress" name="remoteAddress" type="text" maxlength="45" value="<%= tunel.remoteAddress || '' %>" placeholder="203.0.113.10" required>
      </div>
      <div class="campo">
        <label for="tunnelId">Tunnel ID *</label>
        <input id="tunnelId" name="tunnelId" type="number" min="1" max="65535" value="<%= tunel.tunnelId ?? '' %>" required>
      </div>
      <div class="campo">
        <label for="localAddress">IP local (opcional)</label>
        <input id="localAddress" name="localAddress" type="text" maxlength="45" value="<%= tunel.localAddress || '' %>" placeholder="198.51.100.2">
      </div>
      <div class="campo campo--ancho">
        <label for="notes">Notas</label>
        <textarea id="notes" name="notes" rows="2" maxlength="300"><%= tunel.notes || '' %></textarea>
      </div>
    </div>
  </section>
  <div class="formulario__acciones">
    <a class="boton boton--secundario" href="/red/eoip?routerId=<%= router._id %>">Cancelar</a>
    <button type="submit" class="boton boton--primario"><%- include('../partials/icon', { nombre: 'check' }) %> <%= modo === 'crear' ? 'Crear y aplicar' : 'Guardar y aplicar' %></button>
  </div>
</form>
