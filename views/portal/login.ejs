<section class="p-login">
  <div class="p-login__tema"><%- include('_tema') %></div>
  <div class="p-login__fondo" aria-hidden="true">
    <span class="p-orb p-orb--uno"></span>
    <span class="p-orb p-orb--dos"></span>
    <span class="p-orb p-orb--tres"></span>
  </div>

  <div class="p-login__grid">
    <aside class="p-login__intro" data-motion="intro">
      <a class="p-brand p-brand--login" href="/portal/login" aria-label="CRACKENTICK">
        <span class="p-brand__logo" aria-hidden="true">
          <svg viewBox="0 0 40 40" fill="none">
            <path d="M20 3.5 34 11v18L20 36.5 6 29V11L20 3.5Z" stroke="currentColor" stroke-width="1.8"/>
            <path d="M13 24c1.8-3.2 4-4.8 7-4.8s5.2 1.6 7 4.8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            <path d="M15.5 18.5c1.2-1.5 2.7-2.3 4.5-2.3s3.3.8 4.5 2.3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            <circle cx="20" cy="27" r="1.8" fill="currentColor"/>
          </svg>
        </span>
        <span class="p-brand__texto">CRACKEN<strong>TICK</strong><small>Portal de clientes</small></span>
      </a>

      <div class="p-login__mensaje">
        <span class="p-pill p-pill--suave"><%- include('_icono', { nombre: 'spark' }) %> Tu cuenta en un solo lugar</span>
        <h1>Tu servicio,<br><em>claro y a mano.</em></h1>
        <p>Consulta tus facturas, revisa cada pago y abre un ticket de soporte sin llamar ni esperar.</p>
      </div>

      <ul class="p-login__puntos">
        <li><span class="p-login__icono"><%- include('_icono', { nombre: 'receipt' }) %></span><div><strong>Facturación transparente</strong><small>Historial completo, montos y vencimientos.</small></div></li>
        <li><span class="p-login__icono"><%- include('_icono', { nombre: 'ticket' }) %></span><div><strong>Soporte directo</strong><small>Abre un ticket y sigue la conversación.</small></div></li>
        <li><span class="p-login__icono"><%- include('_icono', { nombre: 'wifi' }) %></span><div><strong>Tu servicio al día</strong><small>Plan, velocidad y estado de la conexión.</small></div></li>
      </ul>
    </aside>

    <div class="p-login__panel" data-motion="panel">
      <div class="p-card p-login__card">
        <header class="p-login__cabecera">
          <span class="p-eyebrow">Portal de clientes</span>
          <h2>Entra a tu cuenta</h2>
          <p>Usa el código de cliente y la clave que te entregó el administrador.</p>
        </header>

        <% if (error) { %>
          <div class="p-alerta p-alerta--error" role="alert"><%- include('_icono', { nombre: 'alert' }) %><span><%= error %></span></div>
        <% } %>

        <form action="/portal/login" method="post" class="p-form" data-motion="form">
          <div class="p-field">
            <label for="clientCode">Código de cliente</label>
            <div class="p-field__control">
              <span class="p-field__icono"><%- include('_icono', { nombre: 'user' }) %></span>
              <input id="clientCode" name="clientCode" type="text" autocomplete="username" placeholder="CL-0001" maxlength="20" value="<%= (valores && valores.clientCode) || '' %>" required autofocus>
            </div>
          </div>
          <div class="p-field">
            <label for="password">Clave</label>
            <div class="p-field__control">
              <span class="p-field__icono"><%- include('_icono', { nombre: 'eye' }) %></span>
              <input id="password" name="password" type="password" autocomplete="current-password" placeholder="Tu clave" required>
              <button type="button" class="p-field__ver" data-ver-clave data-objetivo="password" aria-label="Mostrar clave">Ver</button>
            </div>
          </div>
          <button type="submit" class="p-btn p-btn--primario p-btn--bloque">Entrar al portal <%- include('_icono', { nombre: 'arrowRight' }) %></button>
        </form>

        <p class="p-login__nota">¿No tienes clave o la olvidaste? Pídesela al administrador del servicio.</p>
        <a class="p-login__volver" href="/login"><%- include('_icono', { nombre: 'arrowLeft' }) %> Acceso del personal</a>
      </div>
    </div>
  </div>
</section>
