<%
  const v = typeof valores !== 'undefined' && valores ? valores : {};
  const isoFecha = (valor) => {
    const d = valor ? new Date(valor) : new Date();
    return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
  };
  const isoHora = (valor) => {
    const d = valor ? new Date(valor) : new Date();
    return `${isoFecha(d)}T${String(d.getHours()).padStart(2, '0')}:${String(d.getMinutes()).padStart(2, '0')}`;
  };
  const clienteActual = String(reporte.clientId?._id || reporte.clientId || '');
  const ticketActual = String(reporte.ticketId?._id || reporte.ticketId || '');
%>
<section class="pagina-cabecera">
  <div>
    <p class="etiqueta">Reportes · Averías</p>
    <h2 class="pagina-cabecera__titulo"><%= modo === 'editar' ? 'Editar avería' : 'Nueva avería' %></h2>
    <p class="pagina-cabecera__texto">Puedes vincular un ticket: sus datos se completan y quedan bloqueados; técnico, zona y nota siguen editables.</p>
  </div>
  <div class="pagina-cabecera__acciones">
    <a class="boton boton--secundario" href="/red/reportes/averias"><%- include('../partials/icon', { nombre: 'arrowLeft' }) %> Volver</a>
  </div>
</section>

<% if (errores && errores.length) { %>
  <div class="aviso aviso--error" role="alert">
    <span class="aviso__icono"><%- include('../partials/icon', { nombre: 'alert' }) %></span>
    <div class="aviso__texto"><strong>Revisa los datos:</strong><ul class="lista-errores"><% errores.forEach((m) => { %><li><%= m %></li><% }); %></ul></div>
  </div>
<% } %>

<form class="formulario" action="<%= modo === 'editar' ? `/red/reportes/averias/${reporte._id}` : '/red/reportes/averias' %>" method="post">
  <% if (modo === 'editar') { %><input type="hidden" name="_method" value="PUT"><% } %>

  <section class="tarjeta superficie formulario__seccion">
    <div class="formulario__cabecera"><span class="formulario__numero">01</span><div><h3>Ticket y cliente</h3><p>El ticket es opcional y autocompleta los datos de la avería.</p></div></div>
    <div class="formulario__rejilla">
      <div class="campo campo--ancho">
        <label for="ticketId">Ticket</label>
        <select id="ticketId" name="ticketId" data-ticket-averia>
          <option value="">Sin ticket</option>
          <% tickets.forEach((ticket) => { %>
            <option value="<%= ticket._id %>"
              data-cliente="<%= ticket.clientId?._id || ticket.clientId || '' %>"
              data-asunto="<%= ticket.subject %>"
              data-descripcion="<%= ticket.description %>"
              data-prioridad="<%= ticket.priority %>"
              data-tecnico="<%= ticket.assignedTo || '' %>"
              <%= ticketActual === String(ticket._id) ? 'selected' : '' %>><%= ticket.code %> · <%= ticket.subject %><%= ticket.clientId ? ` · ${ticket.clientId.firstName} ${ticket.clientId.lastName}` : '' %></option>
          <% }); %>
        </select>
        <span class="campo__ayuda">Solo se listan tickets abiertos o en proceso.</span>
        <p class="campo__ayuda" data-aviso-ticket hidden>Los datos del ticket están bloqueados. El ticket no se cierra al solventar la avería.</p>
      </div>
      <div class="campo campo--ancho<%= claseCampo(erroresCampo, 'clientId') %>">
        <label for="clientId">Cliente registrado</label>
        <select id="clientId" name="clientId" data-cliente-averia>
          <option value="">Sin cliente registrado</option>
          <% clientes.forEach((cliente) => { %>
            <option value="<%= cliente._id %>" <%= clienteActual === String(cliente._id) ? 'selected' : '' %>><%= cliente.firstName %> <%= cliente.lastName %> · <%= cliente.clientCode %></option>
          <% }); %>
        </select>
        <%- include('../partials/campo-error', { mensaje: errorCampo(erroresCampo, 'clientId') }) %>
      </div>
      <div class="campo campo--ancho">
        <label for="clientName">Cliente (texto libre)</label>
        <input id="clientName" name="clientName" type="text" maxlength="120" value="<%= v.clientName !== undefined ? v.clientName : (reporte.clientName || '') %>" placeholder="Nombre si no está registrado">
      </div>
    </div>
  </section>

  <section class="tarjeta superficie formulario__seccion">
    <div class="formulario__cabecera"><span class="formulario__numero">02</span><div><h3>Datos de la avería</h3><p>Prioridad, fechas y descripción del problema.</p></div></div>
    <div class="formulario__rejilla">
      <div class="campo<%= claseCampo(erroresCampo, 'priority') %>">
        <label for="priority">Prioridad *</label>
        <select id="priority" name="priority">
          <% ['urgent', 'high', 'medium', 'low'].forEach((valor) => { %>
            <option value="<%= valor %>" <%= reporte.priority === valor ? 'selected' : '' %>><%= etiquetas[valor] %></option>
          <% }); %>
        </select>
        <%- include('../partials/campo-error', { mensaje: errorCampo(erroresCampo, 'priority') }) %>
      </div>
      <div class="campo">
        <label for="faultDate">Fecha de la avería *</label>
        <input id="faultDate" name="faultDate" type="date" value="<%= v.faultDate ? String(v.faultDate).slice(0, 10) : isoFecha(reporte.faultDate) %>" required>
      </div>
      <div class="campo">
        <label for="reportedAt">Hora de reporte *</label>
        <input id="reportedAt" name="reportedAt" type="datetime-local" value="<%= v.reportedAt || isoHora(reporte.reportedAt) %>" required>
      </div>
      <div class="campo<%= claseCampo(erroresCampo, 'status') %>">
        <label for="status">Estado *</label>
        <select id="status" name="status">
          <option value="unsolved" <%= reporte.status === 'unsolved' ? 'selected' : '' %>>Sin solventar</option>
          <option value="in_progress" <%= reporte.status === 'in_progress' ? 'selected' : '' %>>En proceso</option>
          <option value="solved" <%= reporte.status === 'solved' ? 'selected' : '' %>>Solventada</option>
        </select>
        <%- include('../partials/campo-error', { mensaje: errorCampo(erroresCampo, 'status') }) %>
      </div>
      <div class="campo campo--ancho<%= claseCampo(erroresCampo, 'problem') %>">
        <label for="problem">Problema *</label>
        <textarea id="problem" name="problem" rows="3" maxlength="300" required><%= v.problem !== undefined ? v.problem : (reporte.problem || '') %></textarea>
        <%- include('../partials/campo-error', { mensaje: errorCampo(erroresCampo, 'problem') }) %>
      </div>
      <div class="campo campo--ancho">
        <label for="note">Nota</label>
        <textarea id="note" name="note" rows="2" maxlength="500"><%= v.note !== undefined ? v.note : (reporte.note || '') %></textarea>
      </div>
    </div>
  </section>

  <section class="tarjeta superficie formulario__seccion">
    <div class="formulario__cabecera"><span class="formulario__numero">03</span><div><h3>Atención y ubicación</h3><p>Zona, técnico y lugar exacto del reporte.</p></div></div>
    <div class="formulario__rejilla">
      <div class="campo">
        <label for="zoneId">Zona</label>
        <select id="zoneId" name="zoneId">
          <option value="">Sin zona</option>
          <% zonas.forEach((zona) => { %>
            <option value="<%= zona._id %>" <%= String(reporte.zoneId?._id || reporte.zoneId || '') === String(zona._id) ? 'selected' : '' %>><%= zona.name %></option>
          <% }); %>
        </select>
      </div>
      <div class="campo">
        <label for="technician">Técnico</label>
        <input id="technician" name="technician" type="text" maxlength="80" list="tecnicos-averia" value="<%= v.technician !== undefined ? v.technician : (reporte.technician || '') %>">
        <datalist id="tecnicos-averia"><% tecnicos.forEach((nombre) => { %><option value="<%= nombre %>"></option><% }); %></datalist>
      </div>
      <div class="campo campo--ancho">
        <label for="location">Ubicación</label>
        <input id="location" name="location" type="text" maxlength="200" value="<%= v.location !== undefined ? v.location : (reporte.location || '') %>" placeholder="Calle, edificio, referencia">
      </div>
    </div>
  </section>

  <div class="formulario__acciones">
    <a class="boton boton--secundario" href="/red/reportes/averias">Cancelar</a>
    <button type="submit" class="boton boton--primario"><%- include('../partials/icon', { nombre: 'check' }) %> <%= modo === 'editar' ? 'Guardar avería' : 'Registrar avería' %></button>
  </div>
</form>
