<% const v = typeof valores !== 'undefined' && valores ? valores : {}; %>
<% const texto = (campo, respaldo) => (v[campo] !== undefined && v[campo] !== null && v[campo] !== '' ? v[campo] : (respaldo ?? '')); %>
<% const sel = (campo, respaldo) => String(v[campo] !== undefined && v[campo] !== null && v[campo] !== '' ? v[campo] : (respaldo || '')); %>
<section class="pagina-cabecera">
  <div>
    <p class="etiqueta">Venta · <%= venta.code %></p>
    <h2 class="pagina-cabecera__titulo">Modificar servicio</h2>
    <p class="pagina-cabecera__texto">Ajusta el plan, router, pool y datos PPPoE antes de instalar.</p>
  </div>
  <div class="pagina-cabecera__acciones">
    <a class="boton boton--secundario" href="/ventas/<%= venta._id %>"><%- include('../partials/icon', { nombre: 'arrowLeft' }) %> Volver</a>
  </div>
</section>

<% if (errores && errores.length) { %>
  <div class="aviso aviso--error" role="alert">
    <span class="aviso__icono"><%- include('../partials/icon', { nombre: 'alert' }) %></span>
    <div class="aviso__texto"><strong>Revisa los datos:</strong><ul class="lista-errores"><% errores.forEach((m) => { %><li><%= m %></li><% }); %></ul></div>
  </div>
<% } %>

<form class="formulario" action="/ventas/<%= venta._id %>/servicio/editar" method="post" data-ip-manual-libre>
  <section class="tarjeta superficie formulario__seccion">
    <div class="formulario__cabecera">
      <span class="formulario__numero">01</span>
      <div><h3>Servicio</h3><p>Estos datos se usarán al instalar la venta.</p></div>
    </div>
    <div class="formulario__rejilla">
      <div class="campo campo--ancho<%= claseCampo(erroresCampo, 'planId') %>">
        <label for="planId">Plan *</label>
        <select id="planId" name="planId" required>
          <option value="">Selecciona un plan</option>
          <% planes.forEach((plan) => { %>
            <option value="<%= plan._id %>" data-plan-modo="<%= plan.trafficMode || 'simple_queue' %>" data-plan-routers="<%= (plan.routerIds || []).map((r) => r?._id || r).join(',') %>" <%= sel('planId', venta.service?.planId?._id || venta.service?.planId) === String(plan._id) ? 'selected' : '' %>><%= plan.name %> · <%= plan.speedLabel %> · <%= plan.trafficMode === 'address_list' ? 'Address list' : 'Cola simple' %></option>
          <% }); %>
        </select>
        <%- include('../partials/campo-error', { mensaje: errorCampo(erroresCampo, 'planId') }) %>
      </div>
      <div class="campo<%= claseCampo(erroresCampo, 'connectionType') %>">
        <label for="connectionType">Tipo de conexión</label>
        <select id="connectionType" name="connectionType" data-conexion>
          <option value="pppoe" <%= sel('connectionType', venta.service?.connectionType || 'pppoe') === 'pppoe' ? 'selected' : '' %>>PPPoE</option>
          <option value="static" <%= sel('connectionType', venta.service?.connectionType || 'pppoe') === 'static' ? 'selected' : '' %>>IP estática</option>
          <option value="dhcp" <%= sel('connectionType', venta.service?.connectionType || 'pppoe') === 'dhcp' ? 'selected' : '' %>>DHCP</option>
        </select>
        <%- include('../partials/campo-error', { mensaje: errorCampo(erroresCampo, 'connectionType') }) %>
      </div>
      <div class="campo<%= claseCampo(erroresCampo, 'routerId') %>">
        <label for="routerId">Router *</label>
        <select id="routerId" name="routerId" required data-router-servicio>
          <option value="">Selecciona un router</option>
          <% routers.forEach((router) => { %>
            <option value="<%= router._id %>" data-router-plan-mode="<%= router.planMode || 'simple_queue' %>" <%= sel('routerId', venta.service?.routerId?._id || venta.service?.routerId) === String(router._id) ? 'selected' : '' %>><%= router.name %> · <%= etiquetas[router.mode] %> · <%= router.planMode === 'address_list' ? 'Address list' : 'Cola simple' %></option>
          <% }); %>
        </select>
        <%- include('../partials/campo-error', { mensaje: errorCampo(erroresCampo, 'routerId') }) %>
      </div>
      <div class="campo<%= claseCampo(erroresCampo, 'ipPoolId') %>">
        <label for="ipPoolId">Pool de IP</label>
        <select id="ipPoolId" name="ipPoolId" data-pool-servicio>
          <option value="">Sin pool</option>
          <% pools.forEach((pool) => { %>
            <option value="<%= pool._id %>" data-router="<%= pool.routerId?._id || pool.routerId || '' %>" data-ips-url="/ventas/api/pools/<%= pool._id %>/ips" <%= sel('ipPoolId', venta.service?.ipPoolId?._id || venta.service?.ipPoolId) === String(pool._id) ? 'selected' : '' %>><%= pool.name %> · <%= pool.cidr %></option>
          <% }); %>
        </select>
        <span class="campo__ayuda" data-pool-ayuda>Al elegir un pool se muestran las IP disponibles.</span>
        <%- include('../partials/campo-error', { mensaje: errorCampo(erroresCampo, 'ipPoolId') }) %>
      </div>
      <div class="campo<%= claseCampo(erroresCampo, 'ipAddress') %>">
        <label for="ipAddressSelect">IP disponible</label>
        <select id="ipAddressSelect" data-ip-servicio data-ip-actual="<%= venta.service?.ipAddress || '' %>" disabled>
          <option value="">Selecciona un pool</option>
        </select>
        <span class="campo__ayuda" data-ip-ayuda>Lista las IP libres del pool seleccionado.</span>
      </div>
      <div class="campo<%= claseCampo(erroresCampo, 'ipAddress') %>">
        <label for="ipAddress">Dirección IP *</label>
        <input id="ipAddress" name="ipAddress" type="text" maxlength="45" value="<%= texto('ipAddress', venta.service?.ipAddress) %>" placeholder="Selecciona la IP del pool" data-ip-manual>
        <span class="campo__ayuda">Debe pertenecer al pool del router.</span>
        <%- include('../partials/campo-error', { mensaje: errorCampo(erroresCampo, 'ipAddress') }) %>
      </div>
      <div class="campo<%= claseCampo(erroresCampo, 'pppoeUsername') %>" data-campo="pppoe">
        <label for="pppoeUsername">Usuario PPPoE</label>
        <input id="pppoeUsername" name="pppoeUsername" type="text" maxlength="60" value="<%= texto('pppoeUsername', venta.service?.pppoeUsername) %>" placeholder="Se genera si queda vacío">
        <%- include('../partials/campo-error', { mensaje: errorCampo(erroresCampo, 'pppoeUsername') }) %>
      </div>
      <div class="campo" data-campo="pppoe">
        <label for="pppoePassword">Nueva contraseña PPPoE</label>
        <input id="pppoePassword" name="pppoePassword" type="password" maxlength="80" placeholder="Dejar vacío para conservar" autocomplete="new-password">
        <span class="campo__ayuda">Por seguridad no se muestra la contraseña actual.</span>
      </div>
      <div class="campo" data-campo="dhcp" hidden>
        <label for="macAddress">MAC del equipo (DHCP)</label>
        <input id="macAddress" name="macAddress" type="text" maxlength="40" value="<%= texto('macAddress', venta.service?.macAddress) %>" placeholder="AA:BB:CC:DD:EE:FF">
        <span class="campo__ayuda">Reserva la IP del cliente en el router.</span>
      </div>
      <div class="campo campo--ancho">
        <label for="notes">Notas</label>
        <textarea id="notes" name="notes" rows="2" maxlength="500"><%= texto('notes', venta.notes) %></textarea>
      </div>
    </div>
  </section>

  <div class="formulario__acciones">
    <a class="boton boton--secundario" href="/ventas/<%= venta._id %>">Cancelar</a>
    <button type="submit" class="boton boton--primario"><%- include('../partials/icon', { nombre: 'check' }) %> Guardar servicio</button>
  </div>
</form>
