<section class="pagina-cabecera">
  <div>
    <p class="etiqueta">Administración · Accesos</p>
    <h2 class="pagina-cabecera__titulo"><%= modo === 'crear' ? 'Nuevo preset' : `Editar ${preset.name}` %></h2>
    <p class="pagina-cabecera__texto">Este preset es una plantilla. Al guardar solo se modifica la plantilla; los permisos de los usuarios no cambian.</p>
  </div>
  <div class="pagina-cabecera__acciones">
    <a class="boton boton--secundario boton--sm" href="/admin/usuarios/presets"><%- include('../partials/icon', { nombre: 'arrowLeft' }) %> Volver</a>
  </div>
</section>

<% if (errores && errores.length) { %>
  <div class="aviso aviso--error" role="alert">
    <span class="aviso__icono"><%- include('../partials/icon', { nombre: 'alert' }) %></span>
    <div class="aviso__texto"><strong>Revisa los datos:</strong><ul class="lista-errores"><% errores.forEach((m) => { %><li><%= m %></li><% }); %></ul></div>
  </div>
<% } %>

<form class="formulario" action="<%= modo === 'crear' ? '/admin/usuarios/presets' : `/admin/usuarios/presets/${preset._id}` %>" method="post">
  <% if (modo === 'editar') { %><input type="hidden" name="_method" value="PUT"><% } %>

  <section class="tarjeta superficie formulario__seccion">
    <div class="formulario__cabecera">
      <span class="formulario__numero">01</span>
      <div><h3>Datos del preset</h3><p>Nombre, descripción y estado.</p></div>
    </div>
    <div class="formulario__rejilla">
      <div class="campo">
        <label for="name">Nombre *</label>
        <input id="name" name="name" type="text" maxlength="60" minlength="2" required value="<%= preset.name || '' %>" placeholder="Ej. Técnico de red">
      </div>
      <div class="campo">
        <label for="description">Descripción</label>
        <input id="description" name="description" type="text" maxlength="200" value="<%= preset.description || '' %>" placeholder="Para qué cargo o tarea se usa">
      </div>
      <div class="campo">
        <label class="switch switch--campo">
          <input type="checkbox" name="active" <%= preset.active !== false ? 'checked' : '' %>>
          <span class="switch__control"></span>
          <span class="switch__texto">Preset activo (aparece al crear usuarios)</span>
        </label>
      </div>
    </div>
  </section>

  <section class="tarjeta superficie formulario__seccion">
    <div class="formulario__cabecera">
      <span class="formulario__numero">02</span>
      <div><h3>Permisos del preset</h3><p>Sin acceso, solo lectura o edición por nodo.</p></div>
    </div>
    <div class="permisos-grupos">
      <% gruposPermisos.forEach((grupo) => { %>
        <div class="permisos-grupo">
          <div class="permisos-grupo__cabecera">
            <span><strong><%= grupo.label %></strong><small><%= grupo.descripcion || '' %></small></span>
          </div>
          <div class="permisos-grupo__nodos">
            <% grupo.nodos.forEach((nodo) => { %>
              <% const listaPermisos = preset.permissions || []; %>
              <% const nivelNodo = listaPermisos.includes(nodo.key) ? 'editar' : (listaPermisos.includes(`${nodo.key}:read`) ? 'ver' : 'none'); %>
              <label class="permiso-fila">
                <span><%= nodo.label %></span>
                <select name="perm__<%= nodo.key.replace(/\./g, '__') %>" class="campo-mini">
                  <option value="none" <%= nivelNodo === 'none' ? 'selected' : '' %>>Sin acceso</option>
                  <option value="ver" <%= nivelNodo === 'ver' ? 'selected' : '' %>>Solo lectura</option>
                  <option value="editar" <%= nivelNodo === 'editar' ? 'selected' : '' %>>Editar</option>
                </select>
              </label>
            <% }); %>
          </div>
        </div>
      <% }); %>
    </div>
  </section>

  <div class="formulario__acciones">
    <a class="boton boton--secundario" href="/admin/usuarios/presets">Cancelar</a>
    <button type="submit" class="boton boton--primario"><%- include('../partials/icon', { nombre: 'check' }) %> Guardar preset</button>
  </div>
</form>
