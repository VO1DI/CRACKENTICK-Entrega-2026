<section class="pagina-cabecera">
  <div>
    <p class="etiqueta">Red · Reportes</p>
    <h2 class="pagina-cabecera__titulo">Editar zona</h2>
    <p class="pagina-cabecera__texto">Cambia el nombre, la descripción o desactívala sin borrar su historial.</p>
  </div>
  <div class="pagina-cabecera__acciones">
    <a class="boton boton--secundario" href="/red/zonas"><%- include('../partials/icon', { nombre: 'arrowLeft' }) %> Volver</a>
  </div>
</section>

<% if (errores && errores.length) { %>
  <div class="aviso aviso--error" role="alert">
    <span class="aviso__icono"><%- include('../partials/icon', { nombre: 'alert' }) %></span>
    <div class="aviso__texto"><strong>Revisa los datos:</strong><ul class="lista-errores"><% errores.forEach((m) => { %><li><%= m %></li><% }); %></ul></div>
  </div>
<% } %>

<form class="formulario" action="/red/zonas/<%= zona._id %>" method="post">
  <input type="hidden" name="_method" value="PUT">
  <section class="tarjeta superficie formulario__seccion">
    <div class="formulario__cabecera"><span class="formulario__numero">01</span><div><h3>Datos de la zona</h3><p>El nombre se muestra como encabezado del reporte diario.</p></div></div>
    <div class="formulario__rejilla">
      <div class="campo campo--ancho<%= claseCampo(erroresCampo, 'name') %>">
        <label for="name">Nombre *</label>
        <input id="name" name="name" type="text" maxlength="60" value="<%= zona.name || '' %>" required>
        <%- include('../partials/campo-error', { mensaje: errorCampo(erroresCampo, 'name') }) %>
      </div>
      <div class="campo campo--ancho">
        <label for="description">Descripción</label>
        <input id="description" name="description" type="text" maxlength="200" value="<%= zona.description || '' %>">
      </div>
      <div class="campo">
        <label for="order">Orden</label>
        <input id="order" name="order" type="number" step="1" value="<%= zona.order ?? 0 %>">
      </div>
      <div class="campo">
        <label class="check-linea"><input type="checkbox" name="active" <%= zona.active ? 'checked' : '' %>> Zona activa</label>
      </div>
    </div>
  </section>
  <div class="formulario__acciones">
    <a class="boton boton--secundario" href="/red/zonas">Cancelar</a>
    <button type="submit" class="boton boton--primario"><%- include('../partials/icon', { nombre: 'check' }) %> Guardar zona</button>
  </div>
</form>
